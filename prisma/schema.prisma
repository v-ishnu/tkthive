// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// =====================================
// ENUMS
// =====================================
enum PlatformRole {
  SUPER_ADMIN
  ADMIN
  ORGANIZER
  USER
}

enum OtpPurpose {
  LOGIN
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum OrganizerType {
  INDIVIDUAL
  COMPANY
}

enum OrganizerUserRole {
  OWNER
  STAFF
}

enum EventRole {
  MANAGER
  SCANNER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum EventVisibility {
  PUBLIC
  PRIVATE
  CUSTOM
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CustomFieldType {
  TEXT
  NUMBER
  EMAIL
  PHONE
  DATE
  DROPDOWN
  CHECKBOX
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  USED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum TicketType {
  INDIVIDUAL
  GROUP
}

enum CustomTabType {
  ABOUT
  SCHEDULE
  SUBMISSIONS
  DOCUMENTS
  SPONSORS
  CUSTOM
}

enum EventCategory {
  TECH
  ESPORTS
  SPORTS
  ARTS
  FEST
  CONCERT
  OTHERS
}

// =====================================
// MODELS
// =====================================
model User {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String  @unique
  password        String?
  phoneNumber     String?
  googleId        String?
  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)

  platformRole PlatformRole @default(USER)
  createdAt    DateTime     @default(now())

  organizerLinks UserOrganizer[]
  eventStaff     EventStaff[]
  bookings       Booking[]
  registrations  EventRegistration[]

  adminOrganizers   Organizer[] @relation("AdminOrganizers")
  createdOrganizers Organizer[] @relation("OrganizerCreator") // ✅ ADD THIS
  notifications     Notification[] // ✅ Added relation

  @@map("users")
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId

  userId    String?  @db.ObjectId // null = broadcast
  role      PlatformRole? // ADMIN / ORGANIZER / USER (for role-based)

  title     String
  message   String
  type      String   // EVENT, BOOKING, PAYMENT, SYSTEM
  actionUrl String?  // deep link (frontend route)

  data      Json?    // extra payload (eventId, bookingId)

  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

model Otp {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String     @db.ObjectId
  otpHash   String
  purpose   OtpPurpose
  expiresAt DateTime
  attempts  Int        @default(0)
  used      Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([userId, purpose])
}

model Organizer {
  id   String        @id @default(auto()) @map("_id") @db.ObjectId
  name String
  type OrganizerType

  // Business profile
  about        String?
  logoUrl      String?
  website      String?
  contactEmail String?
  contactPhone String?

  // Stats (cached, optional but useful)
  totalEvents      Int @default(0)
  totalTicketsSold Int @default(0)

  // Admin-managed vs independent
  adminId   String?  @map("admin_id") @db.ObjectId
  createdBy String   @map("created_by") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  admin   User?           @relation("AdminOrganizers", fields: [adminId], references: [id])
  creator User            @relation("OrganizerCreator", fields: [createdBy], references: [id])
  users   UserOrganizer[]
  events  Event[]

  @@map("organizers")
}

model UserOrganizer {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  userId      String            @map("user_id") @db.ObjectId
  organizerId String            @map("organizer_id") @db.ObjectId
  role        OrganizerUserRole
  createdAt   DateTime          @default(now())

  user      User      @relation(fields: [userId], references: [id])
  organizer Organizer @relation(fields: [organizerId], references: [id])

  @@unique([userId, organizerId])
  @@map("user_organizers")
}

model Event {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  venue       Venue
  imageUrl    String?        // ✅ Added
  slug        String?        @unique // ✅ Added for URL-friendly lookup
  startDate   DateTime
  endDate     DateTime
  evType      EventVisibility
  price       String

  organizerId String? @map("organizer_id") @db.ObjectId
  createdBy   String @map("created_by") @db.ObjectId

  shareCode             String?
  isDiscoverable        Boolean        @default(true)
  isSingleTicket        Boolean        @default(false)
  allowMultipleBookings Boolean        @default(true)
  hasCustomFields       Boolean        @default(false)
  
  // New Fields
  info                 String?
  announcement         String?
  isOnline             Boolean        @default(false)
  isPrivate            Boolean        @default(false)
  isRegistrationOpen   Boolean        @default(true)
  totalBooked          Int            @default(0)
  totalTickets         Int            @default(0)

  showevent            Boolean        @default(true) // ✅ Added

  approvalStatus        ApprovalStatus @default(PENDING)
  approvedBy            String?        @map("approved_by") @db.ObjectId
  approvedAt            DateTime?

  category              EventCategory  @default(OTHERS)
  subCategory           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizer             Organizer?              @relation(fields: [organizerId], references: [id])
  staff                 EventStaff[]
  tickets               Ticket[]
  addons                Addon[]
  tabs                  EventTab[]
  customFields          EventCustomField[]
  registrations         EventRegistration[]
  eventStaffInvitations EventStaffInvitation[]
  
  coupons               Coupon[]       // ✅ Added

  @@index([organizerId])
  @@map("events")
}

/**
 * =======================
 * // Embedded Types
 * =======================
 */
model Addon {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  eventId String @map("event_id") @db.ObjectId

  name     String
  price    Float
  quantity Int?
  sold     Int    @default(0)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@map("addons")
}

type SelectedAddon {
  addonId  String @db.ObjectId
  name     String
  price    Float
  quantity Int
}

type Coupon {
  code               String
  discountPercentage Float
  limit              Int?
  used               Int      @default(0)
}

type Venue {
  name      String
  city      String
  state     String
  country   String
  pincode   String
  latitude  String?
  longitude String?
}

// =====================================
// TICKET {ADMIN INTENT} //User only select this, Basicaly it is a Ticket type
// =====================================
model Ticket {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  eventId String @map("event_id") @db.ObjectId

  name  String
  price Float

  type       TicketType @default(INDIVIDUAL)
  maxMembers Int?
  minMembers Int?

  startDate DateTime?
  endDate   DateTime?
  startTime String?
  endTime   String?

  quantity Int
  sold     Int     @default(0)
  isActive Boolean @default(true)

  allowMultipleBooking Boolean @default(true)

  createdAt DateTime @default(now())

  bookingItems       BookingItem[]
  eventRegistrations EventRegistration[]

  event Event @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@map("tickets")
}

// =====================================
// BOOKING (PAYMENT ONLY)
// =====================================
model Booking {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  userId  String @map("user_id") @db.ObjectId
  orderId String @unique @map("order_id") // 🔑 one payment per order

  payment  Float
  currency String @default("INR")
  // qrCode        String        @unique Beacuse In this booking only ticket id is available

  bookingStatus BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  
  registrationData Json? // Stores full payload (items, attendees, addons) for postponed creation
  
  discount      Float?   // ✅ Added
  appliedCoupon String?  // ✅ Added

  // scanned       Boolean       @default(false)

  // scanned       Boolean       @default(false)
  usedAt      DateTime?
  cancelledAt DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  user               User                @relation(fields: [userId], references: [id])
  items              BookingItem[]
  eventRegistrations EventRegistration[]

  @@index([userId])
  @@map("bookings")
}

model BookingItem {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  bookingId String @db.ObjectId
  ticketId  String @db.ObjectId

  ticketName String
  unitPrice  Float
  quantity   Int
  totalPrice Float

  booking Booking @relation(fields: [bookingId], references: [id])
  ticket  Ticket  @relation(fields: [ticketId], references: [id])

  addons SelectedAddon[]
  attendeeData Json? // Stores raw attendee data (names, fields, etc.) for registration creation

  @@index([bookingId])
  @@map("booking_items")
}

// =====================================
// EVENT REGISTRATION (USER INTENT)
// =====================================
model EventRegistration {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  eventId   String @map("event_id") @db.ObjectId
  userId    String @map("user_id") @db.ObjectId
  bookingId String @db.ObjectId
  ticketId  String @db.ObjectId

  orderId String @map("order_id")

  groupIndex Int?

  addons SelectedAddon[]

  unitPrice Float
  qrCode    String        @unique
  status    BookingStatus @default(PENDING)
  scanned   Boolean       @default(false)

  createdAt DateTime @default(now())

  event   Event   @relation(fields: [eventId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])
  ticket  Ticket  @relation(fields: [ticketId], references: [id])

  registrationData Json? // Stores full attendee list/details for this registration (especially for group tickets)
  submissions      Json? // Stores project submissions or other custom form data

  @@index([bookingId])
  @@index([eventId, scanned])
  @@map("event_registrations")
}

/**
 * =========================
 * // CUSTOM FIELDS
 * =========================
 */
model EventCustomField {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  eventId  String  @map("event_id") @db.ObjectId
  ticketId String? @map("ticket_id") @db.ObjectId

  label    String
  placeholder String? // Added placeholder
  type     CustomFieldType
  required Boolean         @default(false)
  options  String[]        @default([])
  order    Int

  scope String @default("attendee")

  event     Event                @relation(fields: [eventId], references: [id])


  @@map("event_custom_fields")
}

model EventTab {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId   String   @map("event_id") @db.ObjectId

  key       String   // about | schedule | docs | sponsors | custom
  title     String
  schema    Json?
  data      Json?

  order     Int
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id])

  @@index([eventId, key])
  @@map("event_tabs")
}

/**
 * =========================
 * // FIELD RESPONSES
 * =========================
 */


/**
 * =========================
 * // STAFF
 * =========================
 */
model EventStaff {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @map("user_id") @db.ObjectId
  eventId   String    @map("event_id") @db.ObjectId
  role      EventRole
  createdAt DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId, role])
  @@map("event_staff")
}

model EventStaffInvitation {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  eventId   String           @map("event_id") @db.ObjectId
  email     String
  role      EventRole
  invitedBy String           @map("invited_by") @db.ObjectId
  status    InvitationStatus @default(PENDING)
  token     String           @unique
  expiresAt DateTime
  createdAt DateTime         @default(now())

  event Event @relation(fields: [eventId], references: [id])

  @@index([eventId]) // ✅ add here
  @@index([email, eventId])
  @@map("event_staff_invitations")
}
